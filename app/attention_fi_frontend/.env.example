# AttentionFi frontend environment.
#
# Copy to `.env` for local dev, and set the same keys in your Vercel project
# (Settings -> Environment Variables) before deploying. Everything here is
# optional unless marked REQUIRED — the app degrades gracefully, falling back to
# public RPC, synthetic data, or a disabled feature rather than crashing.

# --- Solana / program -------------------------------------------------------
# A keyed RPC (Helius/QuickNode) is strongly recommended: the public devnet
# endpoint rate-limits hard and intermittently drops requests.
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Defaults to the address baked into the bundled IDL; override to point at
# another deployment.
NEXT_PUBLIC_PROGRAM_ID=8fQW2JbfNytdjJ7LR8dvKWMUtpeQPRqxAa3JZvBLsVVc
NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDaSh
# Optional extra handle->mint entries, as a JSON object. Merged over the
# built-in defaults (which already include solana_kol). You rarely need this:
# tokens launched from the UI self-register to localStorage + the Neon DB.
# Use it to pin tokens for a fresh deploy, e.g.
#   NEXT_PUBLIC_TOKEN_REGISTRY={"solana_kol":"FmYyWGtpvBEpyrY5JJhLkhWH1aiWdnVxzivJcBcfis4B"}
NEXT_PUBLIC_TOKEN_REGISTRY=

# --- Database (Neon) — REQUIRED for history, registry and the indexer -------
# Without it: charts fall back to synthetic candles, the launched-token registry
# is localStorage-only (not cross-device), and /api/activity returns empty.
DATABASE_URL=
# POSTGRES_URL is accepted as an alias if that's what your host injects.
POSTGRES_URL=

# --- SAS attestation issuer — REQUIRED for X handle verification ------------
# The dedicated issuer key that signs attestations. Keep secret; server-only.
SAS_ISSUER_SECRET_KEY=
SAS_CREDENTIAL_ADDRESS=
SAS_SCHEMA_ADDRESS=
SAS_RPC_ENDPOINT=
# Used only by scripts/sas-setup.ts (one-time credential/schema creation).
SAS_ISSUER_KEYPAIR_PATH=

# --- X OAuth (proves handle ownership before an attestation is issued) ------
# Without these, /api/verify refuses to issue attestations in production.
# X_REDIRECT_URI must exactly match the callback registered in your X app, and
# must point at the DEPLOYED origin: https://<your-app>/api/verify/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
# Random 32+ byte secret used to HMAC-sign the transient state/proof cookies.
# Generate with: openssl rand -hex 32
X_OAUTH_SECRET=
# Flips the "Verify with X" UI on in the launch flow.
NEXT_PUBLIC_X_OAUTH_ENABLED=false

# --- Mindshare source selection --------------------------------------------
# Which aggregator produces the numbers. Every consumer (feeds, Neon history,
# the Switchboard job's $.mindshare, the on-chain tier) sees the same shape
# regardless, so switching sources needs no other change.
#   auto (default) - Farcaster if configured, then X, then the engine
#   farcaster      - Farcaster only
#   x              - X only
#   engine         - force the deterministic engine (useful for demos)
MINDSHARE_SOURCE=auto

# --- Farcaster mindshare aggregator (free tier available) ------------------
# Neynar API key — get one at https://dev.neynar.com. When set (and the source
# selection allows it), /api/mindshare measures real cast volume per handle:
# mentions of the handle plus its own casts, mirroring the X path's
# "(@handle OR from:handle)". The same key covers both the v2 cast search and
# the snapchain (hub) API used to resolve handles to FIDs; those resolutions are
# cached in Postgres (farcaster_identity) so they cost one lookup, ever.
NEYNAR_API_KEY=
# Cache TTL for a universe sweep, seconds (default 600).
FARCASTER_MINDSHARE_TTL_S=600

# --- Organic X mindshare aggregator ----------------------------------------
# App-only bearer token. When set, /api/mindshare measures real share-of-
# conversation from X; when unset it falls back to the deterministic engine
# (same JSON shape either way, so nothing downstream changes).
# NOTE: verify your X API access tier covers the endpoint — see lib/x-mindshare.ts.
X_BEARER_TOKEN=
# Cache TTL for a universe sweep, seconds (default 600). The counts endpoint is
# aggressively rate-limited; don't lower this much.
X_MINDSHARE_TTL_S=600

# --- Switchboard mindshare oracle ------------------------------------------
# Set to the feed pubkey printed by scripts/create-feed.ts. When present, a
# bonding-curve launch seeds its tier from the on-chain oracle
# (launch_from_feed) instead of a keeper-supplied tier argument.
NEXT_PUBLIC_MINDSHARE_FEED=
# Used only by scripts/create-feed.ts:
#   MINDSHARE_API_BASE    — origin Switchboard's oracles will fetch, e.g.
#                           https://your-app.vercel.app (localhost will NOT work).
#                           An unlisted preview URL is fine — it does not have to
#                           be a public launch.
#   MINDSHARE_API_HEADERS — optional JSON object of request headers, e.g.
#                           {"x-vercel-protection-bypass":"<token>"} so the
#                           deployment can stay behind Deployment Protection.
#                           NOTE: baked into the feed's job definition and
#                           readable by anyone — use a scoped bypass token only.
#   FEED_RPC_URL          — RPC to create the feed on (defaults to devnet)
#   ANCHOR_WALLET         — payer keypair path (default ~/.config/solana/id.json)

# --- Pre-launch ------------------------------------------------------------
# The oracle forces the app to be reachable from the internet, but reachable is
# not launched. Leave this unset (or "false") and app/robots.ts disallows every
# crawler and the pages emit noindex. Set "true" only when you actually launch.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Kaito (PAUSED — superseded by the organic X aggregator) ---------------
# Setting both re-enables the Kaito path in lib/mindshare-engine.ts.
KAITO_API_KEY=
KAITO_API_URL=
KAITO_FIELD=mindshare

# --- Misc -------------------------------------------------------------------
# Handle linked from the site footer/nav.
NEXT_PUBLIC_X_HANDLE=

# Canonical public origin. Baked into verification NFT metadata URIs at mint
# time and effectively permanent, so set this on any deployment that mints —
# otherwise the asset records whatever host the user happened to mint from.
NEXT_PUBLIC_APP_URL=
