################################################################
# Index AttentionFi's on-chain events as subgraphs.
# These power the live mindshare feed (launches, trades, graduations).
################################################################

action "attention_fi_launches" "svm::deploy_subgraph" {
    program_id = action.deploy_attention_fi.program_id
    program_idl = action.deploy_attention_fi.program_idl
    block_height = 0
    event {
        name = "LaunchEvent"
    }
}

action "attention_fi_trades" "svm::deploy_subgraph" {
    program_id = action.deploy_attention_fi.program_id
    program_idl = action.deploy_attention_fi.program_idl
    block_height = 0
    event {
        name = "TradeEvent"
    }
}

